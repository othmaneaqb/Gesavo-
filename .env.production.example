# Production template. Copy values into the deployment secret store; do not
# commit a real .env file.
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY="replace-with-a-unique-random-secret-of-at-least-50-characters"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.example.com,api.example.com

DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# PostgreSQL credentials belong in the deployment secret store.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=replace-with-production-database-name
DJANGO_DB_USER=replace-with-production-database-user
DJANGO_DB_PASSWORD="replace-with-production-database-password"
DJANGO_DB_HOST=replace-with-production-database-host
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=require
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=10

# Must resolve to a durable directory that is never exposed by the web server.
DJANGO_PRIVATE_DOCUMENT_ROOT=/var/lib/gesavo/private-documents
DOCUMENT_MAX_UPLOAD_SIZE_MB=10

TASK_ARCHIVE_AFTER_HOURS=48
TASK_ARCHIVE_INTERVAL_SECONDS=3600

# Enable only after HTTPS works for every listed host and subdomain.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Enable only when a trusted reverse proxy removes client-supplied values and
# sets X-Forwarded-Proto itself.
DJANGO_TRUST_X_FORWARDED_PROTO=true

FRONTEND_URL=https://app.example.com
REACT_APP_API_URL=https://api.example.com/api/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="GesAvo <no-reply@example.com>"
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD="replace-with-smtp-password"
EMAIL_USE_TLS=true

# Required only if seed_demo is explicitly used in this environment.
GESAVO_DEMO_PASSWORD="replace-with-a-strong-temporary-password"
GESAVO_ASSISTANT_PASSWORD="replace-with-a-different-strong-temporary-password"
