# Copy this file to .env for local development. Never commit the real .env.
# Generate a secret with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY="replace-with-a-unique-random-secret"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access is short-lived. Refresh tokens rotate on every use and expire
# after this many days.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# PostgreSQL is the default database. These POSTGRES_* values initialize the
# local Docker service; the matching DJANGO_DB_* values configure Django.
POSTGRES_DB=gesavo
POSTGRES_USER=gesavo
POSTGRES_PASSWORD="replace-with-a-strong-local-database-password"
POSTGRES_PORT=5432
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=gesavo
DJANGO_DB_USER=gesavo
DJANGO_DB_PASSWORD="replace-with-the-same-local-database-password"
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=prefer
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_DB_CONNECT_TIMEOUT=10

# Documents are stored outside public media, with restrictive filesystem
# permissions. Docker Compose mounts its own persistent private volume.
DOCUMENT_MAX_UPLOAD_SIZE_MB=10
# DJANGO_PRIVATE_DOCUMENT_ROOT=C:\secure\gesavo-private-documents

# Completed tasks are archived by the dedicated scheduler service.
TASK_ARCHIVE_AFTER_HOURS=48
TASK_ARCHIVE_INTERVAL_SECONDS=3600

# The production profile enables HTTPS redirect, secure cookies and HSTS.
# Override only when the deployment architecture explicitly requires it.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_TRUST_X_FORWARDED_PROTO=false

FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://127.0.0.1:8000/api/

# Development email backend. Replace with SMTP values in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Cabinet Ait El Hadj <no-reply@aitelhadj.local>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Required only when running `python manage.py seed_demo`.
GESAVO_DEMO_PASSWORD="replace-with-a-strong-temporary-password"
GESAVO_ASSISTANT_PASSWORD="replace-with-a-different-strong-temporary-password"
