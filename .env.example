# Copy this file to .env for local development. Never commit the real .env.
# Generate a secret with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY="replace-with-a-unique-random-secret"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production defaults enable HTTPS redirect, secure cookies and one-hour HSTS
# whenever DJANGO_DEBUG=false. Override only when the proxy handles them.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false
# DJANGO_TRUST_X_FORWARDED_PROTO=false

FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://127.0.0.1:8000/api/

# Development email backend. Replace with SMTP values in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Cabinet Ait El Hadj <no-reply@aitelhadj.local>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Required only when running `python manage.py seed_demo`.
GESAVO_DEMO_PASSWORD="replace-with-a-strong-temporary-password"
GESAVO_ASSISTANT_PASSWORD="replace-with-a-different-strong-temporary-password"
